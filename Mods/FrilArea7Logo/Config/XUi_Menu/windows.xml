<configs>

   <!-- ==========================================================
        AREA 7 MENU BRANDING
        1. Swap the game logo for the Area 7 logo (both placements).
        2. Hide the top-right news / DLC promo tiles.
        ========================================================== -->

   <!-- 1. LOGO SWAP
        The vanilla logo is <texture name="gameLogo"> pointing at
        @:Textures/UI/news_logo.png, in the mainMenu and newsScreen windows.
        The A7 logo is 850x1400 (ratio 0.607, same as vanilla's 0.608), so only
        the texture attribute changes; height/pivot/aspect_ratio/position inherit.
   -->
   <set xpath="//window[@name='mainMenu']/texture[@name='gameLogo']/@texture">@modfolder(FrilArea7Logo):Resources/area7_logo.png</set>
   <set xpath="//window[@name='newsScreen']//texture[@name='gameLogo']/@texture">@modfolder(FrilArea7Logo):Resources/area7_logo.png</set>

   <!-- 2. HIDE THE PROMO TILES
        The two boxes top-right of the main menu (the DLC "featured" tile and the
        "game" update-news tile) live in the mainMenuNews window as two rects.
        Each already has a visible binding on news_count; we override that to a
        hard false so neither ever shows. We only touch the rects' visibility, not
        the window or its controller, so gamepad navigation and layout are safe.
   -->
   <set xpath="//window[@name='mainMenuNews']/rect[@name='game']/@visible">false</set>
   <set xpath="//window[@name='mainMenuNews']/rect[@name='featured']/@visible">false</set>

</configs>
