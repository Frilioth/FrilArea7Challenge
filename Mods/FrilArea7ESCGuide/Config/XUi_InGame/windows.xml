<FrilArea7ESCGuide>

   <!--
      Area 7 ESC guide window. Pure XML, no DLL.

      GEOMETRY (v1.0.2): window anchored CenterCenter, all content inside a "core" rect at
      pos="-560,400" (top-left of the centred box). Content flows RIGHT (+X) / DOWN (-Y).

      LABEL CENTRING - the v1.0.1 mistake and its fix: a label with justify="center" centres
      its text across its PARENT rect's width, so a centred title must sit at pos="0" inside
      a full-width (1100) parent rect, NOT at pos="550". Positioning the label itself at 550
      pushes it to the right edge. This matches how AGF's working window does it.

      Tabs use vanilla TabSelector / TabSelectorButton / TabSelectorTab controllers.
      Technique credit: AGF (AGF-ESCWindow). Fresh single-level Area 7 build, not a reskin.
      All text is a text_key / caption_key into Config/Localization.csv.
   -->

   <append xpath="/windows">
      <window name="windowESC" depth="10" width="1200" height="820" anchor="CenterCenter" cursor_area="true">
         <rect name="tabs" controller="TabSelector" select_tab_contents_on_open="true">

            <!-- Content origin: top-left of the centred box. -->
            <rect name="core" pos="-560,400" disableautobackground="true">

               <!-- HEADER: full-width rect at origin; labels at pos 0 + justify=center -->
               <rect name="header" pos="0,0" width="1100" height="120">
                  <sprite name="headerBg"     depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[a7HeaderBgColor]"    width="1090" height="110" type="sliced"/>
                  <sprite name="headerBorder" depth="1"            sprite="ui_game_header_fill" color="[a7PanelBorderColor]" width="1100" height="120" type="sliced"/>
                  <label name="headerTitle" depth="10" pos="0,-24" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7HeaderTitleColor]" font_size="46" text_key="a7esc_header_title" foregroundlayer="true"/>
                  <label name="headerMotto" depth="10" pos="0,-76" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7HeaderMottoColor]" font_size="24" text_key="a7esc_header_motto" foregroundlayer="true"/>
               </rect>

               <!-- TAB BUTTON STRIP: 3 cells x 204 = 612 wide; centre under 1100 => start at (1100-612)/2 = 244 -->
               <rect name="tabsHeader">
                  <grid name="tabButtons" pos="244,-130" depth="12" rows="1" cols="3" cell_width="204" cell_height="48" repeat_content="true" arrangement="horizontal">
                     <rect controller="TabSelectorButton">
                        <simplebutton name="tabButton" depth="12" pos="0,0" width="200" height="46" font_size="26"
                                      sprite="ui_game_header_fill" bordercolor="[a7TabBorderColor]" defaultcolor="[a7TabBgColor]"
                                      selectedsprite="menu_empty3px" selectedcolor="[a7TabSelectedColor]"
                                      foregroundlayer="false" caption="{tab_name_localized}"/>
                     </rect>
                  </grid>
               </rect>

               <!-- TAB PAGES -->
               <rect name="tabsContents">

                  <rect name="page_situation" controller="TabSelectorTab" tab_key="a7esc_tab_situation">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg"     depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[a7PageBgColor]"      width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1"            sprite="ui_game_header_fill" color="[a7PanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageTitleColor]" font_size="34" text_key="a7esc_situation_title" foregroundlayer="true"/>
                        <label name="text"  depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageBodyColor]" font_size="28" text_key="a7esc_situation_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

                  <rect name="page_escape" controller="TabSelectorTab" tab_key="a7esc_tab_escape">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg"     depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[a7PageBgColor]"      width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1"            sprite="ui_game_header_fill" color="[a7PanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageTitleColor]" font_size="34" text_key="a7esc_escape_title" foregroundlayer="true"/>
                        <label name="text"  depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageBodyColor]" font_size="26" text_key="a7esc_escape_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

                  <rect name="page_tips" controller="TabSelectorTab" tab_key="a7esc_tab_tips">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg"     depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[a7PageBgColor]"      width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1"            sprite="ui_game_header_fill" color="[a7PanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageTitleColor]" font_size="34" text_key="a7esc_tips_title" foregroundlayer="true"/>
                        <label name="text"  depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[a7PageBodyColor]" font_size="28" text_key="a7esc_tips_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

               </rect>
            </rect>
         </rect>
      </window>
   </append>

</FrilArea7ESCGuide>
