<Frils-HUD>

    <!-- v1.1.1: compass + day/time, plus full-width Food and Water stat bars -->

    <!-- Compass with marked center & additional info -->

    <!-- Make compass box 600 wide and keep it centered -->
    <set xpath="/windows/window[@name='windowCompass']/@width">600</set>
    <set xpath="/windows/window[@name='windowCompass']/@pos">-300,-9</set>

    <!-- Remove vanilla grey compass backgrounds -->
    <remove xpath="/windows/window[@name='windowCompass']/sprite[@pos='47,0']"/>
    <remove xpath="/windows/window[@name='windowCompass']/sprite[@pos='50,-3']"/>

    <!-- Show more of the compass strip instead of stretching it -->
    <set xpath="/windows/window[@name='windowCompass']/texture[@name='compassTexture3']/@pos">0,-12</set>
    <set xpath="/windows/window[@name='windowCompass']/texture[@name='compassTexture3']/@width">600</set>
    <set xpath="/windows/window[@name='windowCompass']/texture[@name='compassTexture3']/@rect_size">0.395,1</set>
    <set xpath="/windows/window[@name='windowCompass']/texture[@name='compassTexture3']/@rect_offset">{#compass_rotation / 360 + 0.0625 - 0.1975},0</set>

    <!-- Remove vanilla time block so we can use custom -->
    <remove xpath="/windows/window[@name='windowCompass']/sprite[@pos='240,-60']"/>

    <!-- Add custom center marker and extra info -->
    <append xpath="/windows/window[@name='windowCompass']">

        <!-- Center divider -->
        <label depth="10"
               name="TextContent"
               pos="0,-3"
               width="600"
               height="38"
               text="|"
               font_size="38"
               color="[white]"
               justify="center"/>

        <sprite sprite="" color="255,255,255,255" globalopacitymod="1.8">
            <label depth="2"
                   name="TextContent"
                   pos="300,-57"
                   font_size="28"
                   color="[white]"
                   style="Outlined_Text"
                   justify="center"
                   pivot="center"
                   text="[{daycolor}]{# localization('dayname_' + ((day - 1) % 7 + 1)) }    {time}    {daytitle}: {day}[-]"
                   height="30"
                   upper_case="true"/>
        </sprite>

    </append>

    <!-- ==============================================================
         STAT BARS  (v1.1.1)
         Food and Water were 83 wide sitting side by side. They are now
         171 wide and stacked, matching Stamina and Health.

         Vanilla's rects are kept in place, controller and {statvisible}
         untouched, and only their geometry is patched. Rebuilding these
         rects is what caused the statvisible crashes previously.

         The stack now runs 33px deeper, so the container is raised from
         y=156 to y=189 or the Water bar falls off the bottom of the
         screen. That leaves the same 6px gap under the stack that
         vanilla has. Raising it also lifts the Stealth bar top edge from
         156 to 189.

BUFF POPOUT at 90,165. Fril's tested position, kept as-is.
         For reference, its child item rect is 168x46 with pivot="center"
         at pos 70,0, so the drawn box works out about 14px left of the
         parent and vertically centred on it. Vanilla sat at 90,132.
         ============================================================== -->

    <!-- Raise the stack. NOTE: two rects in this window are name="hud",
         so the row count is needed to pick the stat one. -->
    <set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][@rows='2']/@pos">9,285</set>

    <!-- Food: 83 -> 171 wide, interior matched to the Health bar -->
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/@width">171</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/sprite[@depth='3']/@width">169</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/sprite[@name='BarContent']/@width">169</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/label[@name='TextContent']/@pos">44,-19</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/label[@name='TextContent']/@font_size">26</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/label[@name='TextContent']/@width">125</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/filledsprite[@depth='8']/@width">171</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/filledsprite[@depth='3']/@width">170</set>

    <!-- Water: 83 -> 171 wide, moved from beside Food to below it -->
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/@width">171</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/@pos">0,-168</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/sprite[@depth='3']/@width">169</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/sprite[@name='BarContent']/@width">169</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/label[@name='TextContent']/@pos">44,-19</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/label[@name='TextContent']/@font_size">26</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/label[@name='TextContent']/@width">125</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/filledsprite[@depth='8']/@width">171</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/filledsprite[@depth='3']/@width">170</set>

    <!-- ==============================================================
         XP BAR MOVED TO THE LEFT STACK  (technique credit: AGF)
         The XP values are supplied by the ToolbeltWindow controller, so
         a copy of the bar elsewhere normally renders empty. AGF's
         HUDPlus shows the way round it: a CONTROLLER can be attached to
         any element, not just a window. Putting controller="ToolbeltWindow"
         on the fill sprite gives that one sprite its own controller
         instance, so {xp} and {xpcolor} resolve wherever it lives.
         Same trick on the label with controller="MapStats" for the
         player level.

         Vanilla's three XP sprites above the toolbelt are removed, and
         the stack is raised another 33 to make room, with the buff
         popout raised by the same 33 so it keeps the spacing you tuned.
         ============================================================== -->
    <remove xpath="/windows/window[@name='windowToolbelt']//sprite[@visible='{showxp}']"/>

    <append xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][@rows='2']">
        <rect width="171" height="35" pos="0,-206" xp_fill_speed="2.5">
            <sprite depth="1" name="border" color="0,0,0,128" type="sliced"/>
            <sprite depth="2" name="background" color="0,0,0,160" type="sliced"/>
            <sprite depth="3" name="background" color="110,110,110,160" width="169" type="filled" fillspritepad="true" fill="1"/>
            <sprite depth="5" name="BarContent" color="{xpcolor}" width="169" type="filled" fillspritepad="true" fill="{xp}" controller="ToolbeltWindow"/>
            <sprite depth="6" name="Icon" atlas="{uiatlas}" sprite="ui_game_symbol_arrow_right" size="26,26" pos="16,-18" pivot="center" foregroundlayer="true"/>
            <label depth="7" name="TextContent" pos="44,-19" font_size="26" color="[white]" justify="center" pivot="left" text="LEVEL {cvar($LastPlayerLevel)}" width="125" height="26" controller="MapStats"/>
            <sprite depth="8" name="border" color="0,0,0,255" type="sliced" fillcenter="false"/>
            <filledsprite depth="8" name="background" color="0,0,0,255" width="171" fillcenter="false" type="filled" fill="1"/>
            <filledsprite depth="3" name="background" color="0,0,0,255" width="170" fillcenter="false" type="filled" fill="1"/>
        </rect>
    </append>

    <!-- ==============================================================
         BOX HEIGHT 30 -> 35 so the values are not so tight.
         Stealth stays at vanilla 46: its crouch raise is the hardcoded
         52 in XUiC_HUDStatBar, which only matches a 46-tall bar.

         Interiors do not scale with the rect, so the icon and label are
         re-centred by hand: icon 16,-15 -> 16,-18, label 44,-17 -> 44,-19.
         The border and fill sprites carry no height, so they follow the
         rect on their own.

         Spacing goes 33 -> 38 (35 + the same 3px gap), which pushes the
         stack 25 deeper, so the container rises 9,222 -> 9,247 and the
         buff popout 90,198 -> 90,223 to keep the gap you tuned.
         ============================================================== -->
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stamina']/@height">35</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stamina']/sprite[@name='Icon']/@pos">16,-18</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health']/@height">35</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health']/@pos">0,-92</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health']/sprite[@name='Icon']/@pos">16,-18</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/@height">35</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/@pos">0,-130</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/sprite[@name='Icon']/@pos">16,-18</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/@height">35</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/sprite[@name='Icon']/@pos">16,-18</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stamina']/label[@name='TextContent']/@pos">44,-19</set>
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health']/label[@name='TextContent']/@pos">44,-19</set>

    <!-- ==============================================================
         ELEVATION + CORE TEMP, half width, side by side, below the stack.
         Not stat bars: there is no HUDStatBar stat_type for either, so
         these are plain rects and the controller goes on the LABEL
         (controller="MapStats"), the same trick as the XP bar.
         Deliberately no visible="{statvisible}" on them: only HUDStatBar
         supplies that binding, and putting it on a MapStats element is
         what threw the NRE back in v1.0.9.

         84 wide at x=0 and x=87 gives the same 4px gutter vanilla used
         for its old half-width food/water pair, ending flush at 171.

         Row sits at -244 (38 below XP), so the stack runs 38 deeper:
         container 9,247 -> 9,285 and buff popout 90,223 -> 90,261.
         ============================================================== -->
    <append xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][@rows='2']">
        <rect width="84" height="35" pos="0,-244">
            <sprite depth="1" name="border" color="0,0,0,235" type="sliced"/>
            <sprite depth="2" name="background" color="0,0,0,160" type="sliced"/>
            <sprite depth="3" name="Icon" sprite="ui_game_symbol_climb" size="24,24" pos="14,-18" pivot="center" foregroundlayer="true"/>
            <label depth="4" name="TextContent" pos="30,-19" font_size="20" color="[white]" justify="center" pivot="left" text="{mapelevation}" width="50" height="24" controller="MapStats"/>
            <sprite depth="5" name="border" color="0,0,0,255" type="sliced" fillcenter="false"/>
        </rect>
        <rect width="84" height="35" pos="87,-244">
            <sprite depth="1" name="border" color="0,0,0,235" type="sliced"/>
            <sprite depth="2" name="background" color="0,0,0,160" type="sliced"/>
            <sprite depth="3" name="Icon" sprite="ui_game_symbol_temperature" size="24,24" pos="14,-18" pivot="center" foregroundlayer="true"/>
            <label depth="4" name="TextContent" pos="30,-19" font_size="20" color="[white]" justify="center" pivot="left" text="{playercoretemp}" width="50" height="24" controller="MapStats"/>
            <sprite depth="5" name="border" color="0,0,0,255" type="sliced" fillcenter="false"/>
        </rect>
    </append>

    <!-- Buff popout out of the way of the widened stack -->
    <set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@controller='BuffPopoutList']/@pos">90,261</set>

    <!-- ==============================================================
         TOP-RIGHT POI LOCATION DISPLAY REMOVED.
         windowLocation is anchored TopRight and shows {locationname}
         plus the difficulty skulls, controller="Location". Players know
         where they are, so the whole window goes.
         AGF's HUDPlus removes it the same way, so the game is happy
         with the window simply not existing.
         NOTE this is NOT the same as windowEntering, the transient
         "entering area" banner at the top of the screen, which this
         mod does not touch.
         ============================================================== -->
    <remove xpath="/windows/window[@name='windowLocation']"/>

</Frils-HUD>
