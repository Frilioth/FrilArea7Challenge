<?xml version="1.0" encoding="UTF-8"?>

<!--  
	Area 7 Challenge - Custom Challenge System
	Author: Frilioth
	Version: 3.0.1
	
	CHALLENGE PROGRESSION:
	1. Basics - Kill zombies and get geared up
	2. Generator - Gather materials for emergency transmitter
	3. Deploy - Craft and activate transmitter (triggers blood moon horde + airdrop)
	4. Escape - Reach Army Base and meet Trader Joel
	
	NOTES:
	- Transmitter deployment (deployTransmitter) triggers frilArea7SignalSent gameevent
	- Airdrop contains random vehicle or parts (or IOU note) - escape is possible on foot
	- All challenges use custom icons defined in UIAtlases
-->

<configs>

<set xpath="/challenges">
	
	<challenge_category name="Area7" title="Area 7 Escape" icon="ui_game_symbol_challenge_category1"/>

	<!-- ========================================
	     CHALLENGE GROUPS
	     ======================================== -->
	
	<!-- Group 1: Basics - Kill zombies, get geared up -->
	<challenge_group category="Area7" name="Basics" title_key="challengeGroupBasicsArea7"
	                 reward_text_key="challengeGroupBasicsReward" reward_event="challenge_reward_500" link_challenges="true"/>
	
	<!-- Group 2: Generator - Find parts for emergency transmitter -->
	<challenge_group category="Area7" name="Generator" title_key="challengeGroupGenerator"
	                 reward_text_key="challengeGroupGeneratorReward" reward_event="challenge_reward_generator" link_challenges="true" hidden_by="Basics"/>
	
	<!-- Group 3: Deploy - Build and deploy the emergency transmitter -->
	<challenge_group category="Area7" name="Deploy" title_key="challengeGroupDeploy"
	                 reward_text_key="challengeGroupDeployReward" reward_event="challenge_reward_deploy" link_challenges="true" hidden_by="Generator"/>
	
	<!-- Group 4: Escape - Reach the Army Base -->
	<challenge_group category="Area7" name="Escape" title_key="challengeGroupEscape"
                 reward_text_key="challengeGroupEscapeReward" reward_event="challenge_complete_escape" link_challenges="true"/>

	<!-- ========================================
	     GROUP 1: BASICS
	     ======================================== -->
	
	<challenge name="killZombiesArea7" title_key="challengeKillZombiesArea7" icon="ui_game_symbol_challenge_adv_survival_kill_zombies" group="Basics"
	           short_description_key="challengeKillZombiesArea7Short" description_key="challengeKillZombiesArea7Desc"
	           reward_text_key="challenge_reward_500xp" reward_event="area7_step_one">
		<objective type="KillByTag" entity_tags="zombie" target_name_key="xuiZombies" count="10"/>
	</challenge>

	<!-- ========================================
	     GROUP 2: GENERATOR (Emergency Transmitter)
	     ======================================== -->

	<!-- Step 1: Gather Steel -->
	<challenge name="gatherSteel" title_key="challengeGatherSteel" icon="ui_game_symbol_challenge_harvesting_wrench_vending_machine" group="Generator"
	           hint="challengeGatherSteelHint"
	           short_description_key="challengeGatherSteelShort" description_key="challengeGatherSteelDesc">
		<objective type="Gather" item="resourceForgedSteel" count="125"/>
	</challenge>

	<!-- Step 2: Gather Mechanical Parts -->
	<challenge name="gatherMechanicalParts" title_key="challengeGatherMechanicalParts" icon="ui_game_symbol_challenge_harvesting_mechanical_parts" group="Generator"
	           hint="challengeGatherMechanicalPartsHint"
	           short_description_key="challengeGatherMechanicalPartsShort" description_key="challengeGatherMechanicalPartsDesc">
		<objective type="Gather" item="resourceMechanicalParts" count="50"/>
	</challenge>

	<!-- Step 3: Gather Electrical Parts -->
	<challenge name="gatherElectricalParts" title_key="challengeGatherElectricalParts" icon="ui_game_symbol_challenge_harvesting_electrical_parts" group="Generator"
	           hint="challengeGatherElectricalPartsHint"
	           short_description_key="challengeGatherElectricalPartsShort" description_key="challengeGatherElectricalPartsDesc">
		<objective type="Gather" item="resourceElectricParts" count="50"/>
	</challenge>

	<!-- Step 4: Gather Batteries -->
	<challenge name="gatherBatteries" title_key="challengeGatherBatteries" icon="ui_game_symbol_battery" group="Generator"
	           hint="challengeGatherBatteriesHint"
	           short_description_key="challengeGatherBatteriesShort" description_key="challengeGatherBatteriesDesc">
		<objective type="Gather" item="carBattery" count="5"/>
	</challenge>

	<!-- Step 5: Gather Duct Tape -->
	<challenge name="gatherDuctTape" title_key="challengeGatherDuctTape" icon="ui_game_symbol_duct_tape" group="Generator"
	           hint="challengeGatherDuctTapeHint"
	           short_description_key="challengeGatherDuctTapeShort" description_key="challengeGatherDuctTapeDesc">
		<objective type="Gather" item="resourceDuctTape" count="20"/>
	</challenge>
	
	<!-- ========================================
	     GROUP 3: DEPLOY (Craft and Deploy Transmitter)
	     ======================================== -->	

	<!-- Step 1: Craft Transmitter -->
	<challenge name="craftTransmitter" title_key="challengeCraftTransmitter" icon="ui_game_symbol_transmitter" group="Deploy"
	           hint="challengeCraftTransmitterHint"
	           short_description_key="challengeCraftTransmitterShort" description_key="challengeCraftTransmitterDesc">
		<objective type="Craft" item="satelliteUnitLargeArea7" count="1"/>
	</challenge>

	<!-- Step 2: Deploy Transmitter - THIS TRIGGERS THE EVENT -->
	<challenge name="deployTransmitter" title_key="challengeDeployTransmitter" icon="ui_game_symbol_skull" group="Deploy"
	           hint="challengeDeployTransmitterHint"
	           short_description_key="challengeDeployTransmitterShort" description_key="challengeDeployTransmitterDesc"
	           reward_event="frilArea7SignalSent">
		<objective type="BlockPlace" block="satelliteUnitLargeArea7" count="1"/>
	</challenge>
	
	<!-- ========================================
	     GROUP 4: ESCAPE (Reach the Army Base)
	     ======================================== -->
	
	<challenge name="escapeArea7" title_key="challengeEscapeArea7" icon="ui_game_symbol_challenge_basics_redeem_rewards" group="Escape"
	           hint="challengeEscapeArea7Hint"
	           short_description_key="challengeEscapeArea7Short" description_key="challengeEscapeArea7Desc">
		<objective type="UseItem" count="1" item_names="noteArea7Extraction"/>
	</challenge>

</set>

</configs>