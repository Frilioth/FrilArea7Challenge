<?xml version="1.0" encoding="UTF-8"?>
<!--
    FrilArea7Challenge - Item Modifications
    Author: Frilioth
    Version: 3.1.4

-->

<configs>

  <!-- v3.0.48: honey priced for the drinks vending machine.
       Trader item entries have no price attribute; the price is EconomicValue times the
       trader's markup, and the vending machines run override_buy_markup="3".
       100 x 3 = 300 dukes in the machine. Note this is the baseline: Better Barter
       discounts trader prices, so a perked player pays less. -->
  <set xpath="/items/item[@name='foodHoney']/property[@name='EconomicValue']/@value">100</set>

  <!-- Stop vanilla cough suppressant icon from appearing -->
  <remove xpath="/items/item[@name='foodAtomicSmoothie']/effect_group[@name='Hazard Reducer']/triggered_effect[@action='AddBuff' and @buff='buffWasteland_Hazard_Over']"/>

  <!-- Atomic Smoothie grants the 5 minute Area7 permit -->
  <append xpath="/items/item[@name='foodAtomicSmoothie']">
  <effect_group tiered="false" name="Area7 Radiation Permit">
    <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffArea7RadPermit">
      <requirement name="WornItems" tags="biomeBadge4" operation="EQ" value="0"/>
    </triggered_effect>
  </effect_group>
</append>

  <!-- Wearing the Biome Badge grants permit until removed.

       v3.1.4: every triggered_effect here is now gated on the badge actually being WORN.

       In 7 Days "equip" includes HELD IN HAND, not just worn in a slot. Verified in the
       3.1.0 IL: Inventory.updateHoldingItem fires onSelfEquipStart and onSelfEquipStop,
       the same two events Equipment.SetSlotItem fires. Ungated, that meant simply
       scrolling to the respirator on the toolbelt granted the full radiation permit
       without ever wearing it, and scrolling away took it off again. That shipped in
       every release up to v3.1.3.

       onSelfEquipStop is DELETED rather than gated. It fires when a HELD item is
       holstered, so while the respirator was worn, scrolling away from a slot holding a
       spare would have stripped protection. Removal is handled by
       Area7CentralRadiation.ReconcileArmorPermit instead, which runs once a second and
       is authoritative. Being slow to REMOVE protection would be the exploitable
       direction; being slow to GRANT it just costs a radiation tick, so the DLL owning
       removal is the safe way round.

       The DLL reconcile also stays as the net for any route these triggers miss, which
       is how the auto-equip case was found: the right-click Wear action does not go
       through Equipment.SetSlotItem and so fires no event at all. -->
  <append xpath="/items/item[@name='biomeWeatherItem4']">
  <effect_group name="Area7 Radiation Armor Permit">
    <triggered_effect trigger="onSelfEquipStart" action="RemoveBuff" buff="buffArea7RadPermit">
      <requirement name="WornItems" tags="biomeBadge4" operation="GTE" value="1"/>
    </triggered_effect>
    <triggered_effect trigger="onSelfEquipStart" action="AddBuff" buff="buffArea7RadPermitArmor">
      <requirement name="WornItems" tags="biomeBadge4" operation="GTE" value="1"/>
    </triggered_effect>

    <triggered_effect trigger="onSelfEnteredGame" action="AddBuff" buff="buffArea7RadPermitArmor">
      <requirement name="WornItems" tags="biomeBadge4" operation="GTE" value="1"/>
    </triggered_effect>
  </effect_group>
</append>

</configs>