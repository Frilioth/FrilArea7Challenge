<!--
    FrilArea7Challenge - Blocks
    Author: Frilioth
    Version: 2.2.9

-->

<configs>

	<remove xpath="//drop[@name='smallEngine']"/>

	<append xpath="/blocks">

		<block name="satelliteUnitLargeArea7">
			<property name="Class" value="Block"/>
			<property name="CustomIcon" value="satelliteUnitLarge"/>
			<property name="DisplayType" value="blockElectrical"/>
			<property name="CanPickup" value="false"/>
			<property name="Material" value="Mmetal_thin"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Electrical/satelliteUnitLargePrefab.prefab"/>
			<property name="ModelOffset" value="0,0,0"/>
			<property name="GndAlign" value="1"/>
			<property name="MultiBlockDim" value="1,2,1"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="AllowAllRotations" value="true"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="EconomicValue" value="5000"/>
			<property name="CreativeMode" value="Player"/>

			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceElectricParts" count="25,50" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMechanicalParts" count="25,50" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceForgedSteel" count="50,100" tag="salvageHarvest"/>
			<drop event="Destroy" name="resourceScrapIron" count="50"/>
			<drop event="Fall" name="scrapMetalPile" count="10" prob="1" stick_chance="1"/>

			<property name="SortOrder1" value="B150"/>
			<property name="SortOrder2" value="0000"/>
			<property name="Group" value="Science"/>
			<property name="FilterTags" value="MC_building,SC_electrical,MC_outdoor,SC_decor"/>
		</block>

		<block name="posterProstate">
			<property name="TitleKey" value="posterProstateTitle"/>
			<property name="DescriptionKey" value="posterProstateDesc"/>
			<property name="CustomIcon" value="posterProstate"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Material" value="Mpaper"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/hospitalPoster.unity3d?Prostate.prefab"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="IsDecoration" value="true"/>
			<property name="Stacknumber" value="10" />
			<property name="CanPickup" value="false"/>
			<property name="ImposterDontBlock" value="true"/>
			<drop event="Destroy" count="0"/>
			<property name="FilterTags" value="fdecor,fother"/>
			<property name="SortOrder1" value="7000"/>
			<property name="SortOrder2" value="0002"/>
			<property name="SellableToTrader" value="false"/>
			<property name="Group" value="Decor/Miscellaneous"/>
		</block>
		
		<block name="posterARUK">
			<property name="TitleKey" value="posterARUKTitle"/>
			<property name="DescriptionKey" value="posterARUKDesc"/>
			<property name="CustomIcon" value="ARUK"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Material" value="Mpaper"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/hospitalPoster.unity3d?ARUK.prefab"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="IsDecoration" value="true"/>
			<property name="Stacknumber" value="10" />
			<property name="CanPickup" value="false"/>
			<property name="ImposterDontBlock" value="true"/>
			<drop event="Destroy" count="0"/>
			<property name="FilterTags" value="fdecor,fother"/>
			<property name="SortOrder1" value="7000"/>
			<property name="SortOrder2" value="0002"/>
			<property name="SellableToTrader" value="false"/>
			<property name="Group" value="Decor/Miscellaneous"/>
		</block>
		
		<block name="posterARUK1">
			<property name="TitleKey" value="posterARUK1Title"/>
			<property name="DescriptionKey" value="posterARUK1Desc"/>
			<property name="CustomIcon" value="ARUK1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Material" value="Mpaper"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/hospitalPoster.unity3d?ARUK1.prefab"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="IsDecoration" value="true"/>
			<property name="Stacknumber" value="10" />
			<property name="CanPickup" value="false"/>
			<property name="ImposterDontBlock" value="true"/>
			<drop event="Destroy" count="0"/>
			<property name="FilterTags" value="fdecor,fother"/>
			<property name="SortOrder1" value="7000"/>
			<property name="SortOrder2" value="0002"/>
			<property name="SellableToTrader" value="false"/>
			<property name="Group" value="Decor/Miscellaneous"/>
		</block>

	</append>

<!-- Area 7: plant pots can drop ONE oak sapling with ~10% total chance on Harvest. -->

<append xpath="/blocks/block[@name='treePlant02']">
    <drop event="Harvest" name="treePlantedOak1m" count="1" prob="0.1"/>
    <drop event="Destroy" name="treePlantedOak1m" count="1" prob="0.1"/>
</append>

<!-- ========================================
     REMOVE SUNLIGHT REQUIREMENT FROM CROPS
     Allows plants to grow underground/indoors
     ======================================== -->
<append xpath="//block[@name='cropsGrowingMaster']">
	<property name="PlantGrowing.LightLevelGrow" value="0"/>
	<property name="PlantGrowing.LightLevelStay" value="0"/>
</append>
	

</configs>
