	        code="AAPABADAMBANBBIEBJEBKEBLEBNFBPFCIDCJDCDACAACFDCGACKDCXBEBCEXGFKAEPAEQAEUAEVAERAFLJFMDFNDFOJ" />

</area7_presets>
