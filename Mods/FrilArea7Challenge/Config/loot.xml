	<insertafter xpath="//lootcontainer[@name='playerBackpack']">
		<!-- Area 7 Airdrop Containers - Tier-based vehicle lottery -->

		<!-- Tier 1: 0-4 magazines (No qualifications) -->
		<lootcontainer name="210" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="frilArea7AirdropTier1"/>
		</lootcontainer>

		<!-- Tier 2: 5-19 magazines (Bicycle certified) -->
		<lootcontainer name="211" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="frilArea7AirdropTier2"/>
		</lootcontainer>

		<!-- Tier 3: 20-44 magazines (Motorized certified) -->
		<lootcontainer name="212" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="frilArea7AirdropTier3"/>
		</lootcontainer>

		<!-- Tier 4: 45-69 magazines (Advanced mechanic) -->
		<lootcontainer name="213" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="frilArea7AirdropTier4"/>
		</lootcontainer>

		<!-- Tier 5: 70+ magazines (Master mechanic - GYRO UNLOCKED!) -->
		<lootcontainer name="214" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="frilArea7AirdropTier5"/>
		</lootcontainer>

		<lootcontainer id="Area7Medical" name="Area7Medical" count="2,4" size="6,2" sound_open="UseActions/open_backpack" sound_close="UseActions/close_backpack" loot_quality_template="qualBaseTemplate">
			<item group="groupMedicalAll"/>
