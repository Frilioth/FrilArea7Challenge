		</lootcontainer>

		<lootcontainer id="Area7Heavy" name="Area7Heavy" count="3,5" size="6,2" sound_open="UseActions/open_backpack" sound_close="UseActions/close_backpack" loot_quality_template="qualBaseTemplate">
