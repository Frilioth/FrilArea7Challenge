	<!-- Override vanilla toilet loot container to use Area 7 loot -->
	<set xpath="//lootcontainer[@name='toilet']/item[@group]/@group">frilArea7ToiletLoot</set>


<!-- ===================== -->
<!-- Area 7: Buff zombie bag loot only (vanilla mob-specific packs) -->
<!-- NOTE: groupZpack* are wrapper lootgroups; use RandomRoll requirements for chance-gated extras -->
<!-- ===================== -->

<append xpath="//lootgroup[@name='groupZpackReg']">
	<item group="groupToolsT0" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="20"/>
	</item>
	<item group="groupFoodCommon" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="15"/>
	</item>
	<item group="groupMedicalAll" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="10"/>
	</item>

	<!-- Hydroponics Farming mod crops: roll at most ONE crop, low chance -->
	<item group="frilArea7RegCrops" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="12"/>
	</item>
</append>

<append xpath="//lootgroup[@name='groupZpackStrong']">
	<!-- Guaranteed: exactly one of Mechanical/Electrical -->
	<item group="frilArea7StrongGuaranteedParts" count="1"/>

	<!-- Extra juice for strong mobs (chance-based) -->
	<item group="groupToolsT1" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="25"/>
	</item>
	<item group="groupFoodCommon" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="20"/>
	</item>
	<item group="groupMedicalAll" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="15"/>
	</item>
	<item group="frilArea7VehicleParts" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="15"/>
	</item>
</append>

<append xpath="//lootgroup[@name='groupZpackNurse']">
	<!-- Nurse bonus: roll ONE bonus item, not all -->
	<item group="frilArea7NurseBonus" count="1">
		<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="60"/>
