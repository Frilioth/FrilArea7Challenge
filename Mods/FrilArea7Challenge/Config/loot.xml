		<lootcontainer id="Area7Biker" name="Area7Biker" count="2,4" size="6,2" sound_open="UseActions/open_backpack" sound_close="UseActions/close_backpack" loot_quality_template="qualBaseTemplate">
			<item group="groupGarage01"/>
		</lootcontainer>

		<lootcontainer id="Area7Cops" name="Area7Cops" count="2,4" size="6,2" sound_open="UseActions/open_backpack" sound_close="UseActions/close_backpack" loot_quality_template="qualBaseTemplate">
