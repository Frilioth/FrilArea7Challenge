	<set xpath="//entity_class[contains(@name, 'player')]/property[contains(@name, 'ItemsOnEnterGame')]/@value">noteArea7Rules,meleeWpnBladeT1HuntingKnife,medicalFirstAidBandage,drinkJarBoiledWater,foodCanChili</set>
